<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HorusApp.ViewModels"
             x:Class="HorusApp.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="Horus SIEM - Ingreso"
             BackgroundColor="#05050A"
             Shell.NavBarIsVisible="False">

	<ContentPage.Resources>
		<ResourceDictionary>
			<!-- Estilo Global de Inputs -->
			<Style TargetType="Entry">
				<Setter Property="TextColor" Value="#FFFFFF" />
				<Setter Property="PlaceholderColor" Value="#55555E" />
				<Setter Property="BackgroundColor" Value="Transparent" />
				<Setter Property="FontSize" Value="14" />
				<Setter Property="VerticalOptions" Value="Center" />
			</Style>

			<!-- Estilo para los contenedores de los inputs (Bordes) -->
			<Style x:Key="InputContainerStyle" TargetType="Border">
				<Setter Property="BackgroundColor" Value="#0D0E15" />
				<Setter Property="Stroke" Value="#153A61" />
				<Setter Property="StrokeThickness" Value="1.5" />
				<Setter Property="StrokeShape" Value="RoundRectangle 10" />
				<Setter Property="Padding" Value="12,0" />
				<Setter Property="HeightRequest" Value="50" />
			</Style>
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid RowDefinitions="*, Auto" BackgroundColor="#05050A">

		<ScrollView Grid.Row="0" VerticalOptions="CenterAndExpand">
			<VerticalStackLayout Padding="24" Spacing="20" MaximumWidthRequest="420" HorizontalOptions="Center">

				<!-- Logo de Horus SIEM -->
				<Image HeightRequest="100" 
                       WidthRequest="100" 
                       HorizontalOptions="Center" 
                       Margin="0,0,0,5">
					<Image.Source>
						<FileImageSource File="horus_logo_splash.svg" />
					</Image.Source>
				</Image>

				<Label Text="Horus SIEM"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="White" />

				<Label Text="Security Information &amp; Event Management"
                       FontSize="13"
                       HorizontalOptions="Center"
                       Margin="0,-15,0,10"
                       TextColor="#8E8E93" />

				<!-- Tarjeta Principal de Login -->
				<Border BackgroundColor="#0A0B10"
                        Stroke="#1A1C24"
                        StrokeThickness="1"
                        Padding="24, 28"
                        StrokeShape="RoundRectangle 18">

					<VerticalStackLayout Spacing="18">

						<Label Text="Iniciar Sesión"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />

						<Label Text="Ingrese sus credenciales para acceder al dashboard."
                               FontSize="13"
                               TextColor="#8E8E93"
                               Margin="0,-12,0,5"/>

						<!-- Contenedor de Error -->
						<Border BackgroundColor="#2D1214" 
                                Stroke="#5A1E20" 
                                StrokeThickness="1" 
                                Padding="12" 
                                StrokeShape="RoundRectangle 8"
                                IsVisible="False">
							<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
								<Label Text="⚠️" TextColor="#FF4D4D" VerticalOptions="Center"/>
								<Label Text="Mensaje de error" TextColor="#FF4D4D" FontSize="13" VerticalOptions="Center"/>
							</HorizontalStackLayout>
						</Border>

						<!-- INPUT USUARIO -->
						<VerticalStackLayout Spacing="6">
							<Label Text="USUARIO" FontSize="11" FontAttributes="Bold" TextColor="#00F2FE" CharacterSpacing="1"/>

							<Border Style="{StaticResource InputContainerStyle}">
								<Entry Text="{Binding Username, Mode=TwoWay}"
                                       Placeholder="admin"
                                       Keyboard="Plain"
                                       ReturnType="Next" />
							</Border>
						</VerticalStackLayout>

						<!-- INPUT CONTRASEÑA -->
						<VerticalStackLayout Spacing="6">
							<Label Text="CONTRASEÑA" FontSize="11" FontAttributes="Bold" TextColor="#00F2FE" CharacterSpacing="1"/>

							<Border Style="{StaticResource InputContainerStyle}">
								<Grid ColumnDefinitions="*, Auto">
									<Entry x:Name="PasswordEntry"
                                           Grid.Column="0"
                                           Text="{Binding Password, Mode=TwoWay}"
                                           Placeholder="••••••••"
                                           IsPassword="True"
                                           ReturnType="Done" />

									<Button x:Name="ToggleButton"
                                            Grid.Column="1" 
                                            Text="Ver" 
                                            Clicked="OnTogglePasswordClicked"
                                            TextColor="#00F2FE"
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            HeightRequest="40"
                                            VerticalOptions="Center"
                                            BackgroundColor="Transparent"
                                            Padding="5,0"/>
								</Grid>
							</Border>
						</VerticalStackLayout>

						<!-- Loader -->
						<ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="#00F2FE" 
                                           HeightRequest="30"/>

						<!-- Botón de Acción -->
						<Button Text="Acceder"
                                Command="{Binding LoginCommand}"
                                Margin="0,10,0,0"
                                BackgroundColor="#0C1829"
                                TextColor="#00F2FE"
                                BorderColor="#153A61"
                                BorderWidth="1"
                                HeightRequest="48"
                                CornerRadius="10"
                                FontAttributes="Bold"
                                FontSize="15" />

					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
		</ScrollView>

		<!-- Footer -->
		<HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" Margin="0,0,0,20" Spacing="5">
			<Label Text="Horus SIEM v0.1.0 —" FontSize="11" TextColor="#444448"/>
			<Label Text="Credenciales generadas al iniciar el servidor" FontSize="11" TextColor="#444448"/>
		</HorizontalStackLayout>

	</Grid>
</ContentPage>