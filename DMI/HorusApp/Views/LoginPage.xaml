<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HorusApp.ViewModels"
             x:Class="HorusApp.Views.LoginPage"
             x:DataType="viewmodels:LoginViewModel"
             Title="Horus SIEM - Ingreso"
             BackgroundColor="#050505"
             Shell.NavBarIsVisible="False">

	<ContentPage.Resources>
		<ResourceDictionary>
			<Style TargetType="Entry">
				<Setter Property="TextColor" Value="White" />
				<Setter Property="BackgroundColor" Value="#101012" />
				<Setter Property="PlaceholderColor" Value="#444448" />
				<Setter Property="HeightRequest" Value="45" />
			</Style>
		</ResourceDictionary>
	</ContentPage.Resources>

	<Grid RowDefinitions="*, Auto" BackgroundColor="#050505">

		<ScrollView Grid.Row="0" VerticalOptions="CenterAndExpand">
			<VerticalStackLayout Padding="24" Spacing="20" MaximumWidthRequest="420" HorizontalOptions="Center">

				<Image HeightRequest="60" WidthRequest="60" HorizontalOptions="Center" Margin="0,0,0,5">
					<Image.Source>
						<FontImageSource Glyph="🛡️" Color="#0066B3" Size="50"/>
					</Image.Source>
				</Image>

				<Label Text="Horus SIEM"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="White" />

				<Label Text="Security Information &amp; Event Management"
                       FontSize="13"
                       HorizontalOptions="Center"
                       Margin="0,-15,0,10"
                       TextColor="#8E8E93" />

				<Border BackgroundColor="#000000"
                        Stroke="#1C1C1C"
                        StrokeThickness="1"
                        Padding="24, 28"
                        StrokeShape="RoundRectangle 16">

					<VerticalStackLayout Spacing="16">

						<Label Text="Iniciar Sesión"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />

						<Label Text="Ingrese sus credenciales para acceder al dashboard."
                               FontSize="13"
                               TextColor="#8E8E93"
                               Margin="0,-10,0,5"/>

						<Border BackgroundColor="#1F060A" 
                                Stroke="#4A0C14" 
                                StrokeThickness="1" 
                                Padding="12" 
                                StrokeShape="RoundRectangle 8"
                                IsVisible="False">
							<HorizontalStackLayout Spacing="10" VerticalOptions="Center">
								<Label Text="⚠️" TextColor="#FF3B30" VerticalOptions="Center"/>
								<Label Text="Mensaje de error" TextColor="#FF3B30" FontSize="13" VerticalOptions="Center"/>
							</HorizontalStackLayout>
						</Border>

						<VerticalStackLayout Spacing="6">
							<Label Text="USUSARIO" FontSize="11" FontAttributes="Bold" TextColor="#8E8E93" CharacterSpacing="1"/>
							<Border Stroke="#1A1A1E" BackgroundColor="#101012" StrokeShape="RoundRectangle 6" Padding="5,0">
								<Entry Text="{Binding Username, Mode=TwoWay}"
									   Placeholder="admin"
									   Keyboard="Plain"
									   ReturnType="Next"
									   BackgroundColor="Transparent"/>
							</Border>
						</VerticalStackLayout>

						<VerticalStackLayout Spacing="6">
							<Label Text="CONTRASEÑA" FontSize="11" FontAttributes="Bold" TextColor="#8E8E93" CharacterSpacing="1"/>
							<Border Stroke="#1A1A1E" BackgroundColor="Transparent" StrokeShape="RoundRectangle 6" Padding="10,0">
								<Grid ColumnDefinitions="*, Auto">

									<Entry x:Name="PasswordEntry"
										   Grid.Column="0"
										   Text="{Binding Password, Mode=TwoWay}"
										   Placeholder="********"
										   IsPassword="True"
										   ReturnType="Done" />

									<Button Grid.Column="1" 
											Text="Ver" 
											Clicked="OnTogglePasswordClicked"
											TextColor="#008BC4"
											FontAttributes="Bold"
											FontSize="12"
											HeightRequest="35"
											VerticalOptions="Center"
											BackgroundColor="Transparent"
											Padding="5,0"/>
								</Grid>
							</Border>
						</VerticalStackLayout>

						<ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           Color="#0066B3" 
										   />

						<Button Text="Acceder"
                                Command="{Binding LoginCommand}"
                                Margin="0,10,0,0"
                                TextColor="White"
                                BackgroundColor="#0066B3"
                                HeightRequest="45"
                                CornerRadius="8"
                                FontAttributes="Bold" />

					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
		</ScrollView>

		<HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" Margin="0,0,0,20" Spacing="5">
			<Label Text="Horus SIEM v0.1.0 —" FontSize="11" TextColor="#444448"/>
			<Label Text="Credenciales generadas al iniciar el servidor" FontSize="11" TextColor="#444448"/>
		</HorizontalStackLayout>

	</Grid>
</ContentPage>