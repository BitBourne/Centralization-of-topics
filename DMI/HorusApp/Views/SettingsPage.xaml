<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:HorusApp.ViewModels"
             x:Class="HorusApp.Views.SettingsPage"
             x:DataType="viewmodels:LogoutViewModel"
             Title="Ajustes"
             BackgroundColor="#05050A"
             Shell.NavBarIsVisible="False">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="24">

			<!-- SECCIÓN: CUENTA Y SESIÓN -->
			<VerticalStackLayout Spacing="8">
				<Label Text="CUENTA" 
                       TextColor="#00F3FF" 
                       FontSize="12" 
                       FontAttributes="Bold" 
                       CharacterSpacing="1.5" 
                       Margin="4,0,0,0"/>

				<Border BackgroundColor="#0A0B10"
                        Stroke="#1A1C24"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">

					<VerticalStackLayout Spacing="16">
						<Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
							<Image Grid.Column="0" 
                                   Source="account_circle.png" 
                                   HeightRequest="32" 
                                   WidthRequest="32"
                                   VerticalOptions="Center"/>

							<VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
								<Label Text="Sesión Activa" TextColor="White" FontSize="15" FontAttributes="Bold"/>
								<Label Text="Dispositivo registrado" TextColor="#A0A0A5" FontSize="12"/>
							</VerticalStackLayout>
						</Grid>

						<BoxView HeightRequest="1" Color="#2A2A2E"/>

						<!-- BOTÓN DE CERRAR SESIÓN -->
						<Button Text="Cerrar Sesión"
                                Command="{Binding ExecuteLogoutCommand}"
                                IsEnabled="{Binding IsNotProcessing}"
                                BackgroundColor="#2D1214"
                                TextColor="#FF4D4D"
                                BorderColor="#5A1E20"
                                BorderWidth="1"
                                CornerRadius="8"
                                HeightRequest="46"
                                FontAttributes="Bold"/>
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>

			<!-- INDICADOR DE PROCESO Y ESTADO -->
			<VerticalStackLayout IsVisible="{Binding IsProcessing}" 
                                 Spacing="12" 
                                 HorizontalOptions="Center" 
                                 Margin="0,12">
				<ActivityIndicator IsRunning="{Binding IsProcessing}" 
                                   Color="#00F3FF" 
                                   HeightRequest="32" 
                                   WidthRequest="32"/>
				<Label Text="{Binding StatusMessage}" 
                       TextColor="#A0A0A5" 
                       FontSize="13" 
                       HorizontalTextAlignment="Center"/>
			</VerticalStackLayout>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>